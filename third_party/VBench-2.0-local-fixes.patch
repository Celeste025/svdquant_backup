     return duration, fps
 
 def split_video(filepath, output_folder):
     filename = os.path.basename(filepath)
     name, _ = os.path.splitext(filename)
     duration, fps = get_video_info(filepath)
-    total_segments = int(duration) - 1 
+    total_segments = int(duration) - 1
 
-    for i in range(total_segments): 
