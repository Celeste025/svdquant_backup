+        with av.open(filepath) as inp, av.open(out_path, "w") as out:
+            vstream = out.add_stream("libx264", rate=Fraction(int(round(fps)), 1))
+            vstream.width = inp.streams.video[0].width
+            vstream.height = inp.streams.video[0].height
+            vstream.pix_fmt = "yuv420p"
+            inp.seek(int(i * 1_000_000), stream=inp.streams.video[0])
+            start = None
+            n = 0
