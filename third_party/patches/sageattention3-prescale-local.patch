-auto
-partition_SFA(SFATensor&& sfatensor, ThrMma& thread_mma) {
-  auto thr_tensor = make_tensor(static_cast<SFATensor&&>(sfatensor).data(), thrfrg_SFA(sfatensor.layout(),thread_mma));
