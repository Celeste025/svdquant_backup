-/*
- * P-side Hadamard rotation (PV reconditioning).
- *
- * The P~ (unnormalized softmax numerator) FP4 quantization groups suffer when
- * one hot probability sets the group scale and crushes the other 15 lanes.
- * The pair rotation  P~@R @ R^T@V == P~@V  (R = normalized block-diagonal
- * Walsh-Hadamard, 16 consecutive keys per block, matching the group size)
- * spreads that outlier energy inside each group. V is pre-rotated on the host
- * side (api.py) before its NVFP4 quantization; P~ is rotated HERE, on the
- * current KV tile's unnormalized numerator, right between the exp2 and the
- * FP4 quantization — no full-row softmax, no second pass over K.
- *
- * Register layout (measured via tScS identity partition on sm_120a,
- * SM120_16x32x64_TN_VS_NVFP4 atom): within a quad (threads t = lane%4) each
- * thread holds 8 interleaved columns of the 32-column MMA atom N tile,
- *     col(j, t, ni) = 32*ni + 8*(j/2) + (j%2) + 2*t,   j = AtomN index 0..7
- * so the 16 CONSECUTIVE columns [16g, 16g+16) of tile ni live in quad pair
- *     j in {4g+0, 4g+1} -> col = 16g + 2t + {0,1}     (low half,  t = lane%4)
- *     j in {4g+2, 4g+3} -> col = 16g + 8 + 2t + {0,1} (high half)
- * The Sylvester H16 butterfly over those 16 values decomposes into
- *     d=8: purely local      (pairs j0<->j2, j1<->j3)
- *     d=4: shfl_xor(2) across the quad pair
- *     d=2: shfl_xor(1) across the quad pair
- *     d=1: purely local      (pairs j0<->j1, j2<->j3)
- * with the low-column thread of each remote pair keeping the sum and the
- * high-column thread keeping the difference, then a final *0.25f (the four
- * 1/sqrt(2) factors of the normalized H16).
- *
- * Scale bookkeeping: the stock kernel bakes 448*6 = 2688 into the exp2 so
- * that acc = 2688*P~ and AbsMaxP = 448*groupmax fits ue4m3 only because
- * groupmax <= 1 (row-max-subtracted numerators). After the rotation a group's
- * abs-max reaches sqrt(16) = 4, which would overflow that encoding by 4x.
- * We therefore bake 2688/4 = 672 instead (softmax_scale_log2 + 2 in the
- * exponent): acc = 672*P~@R, row_sum = 672*sum(P~) (accumulated BEFORE the
- * rotation — rowsum(P~@R) != rowsum(P~)!), AbsMaxP = 112*groupmax <= 448,
- * data = acc/AbsMaxP = 6*(P~@R)/groupmax in [-6, 6]. The 1/4 cancels between
- * numerator and denominator, so the epilogue math is untouched.
- *
- * AbsMaxP semantics change under rotation: the stock code derives it from
- * the pre-softmax logits group max (monotone exp2 mapping); the rotated
- * group abs-max cannot be derived that way, so it is recomputed directly on
- * the rotated values (local fabs-max over the 8 AtomN lanes + shfl_xor(1)
- * with the neighbour thread — the same 16-column SF-group partition the
- * hardware scale factor expects).
- */
-
-template <int Rows, bool RotateP_ = false>
-struct SoftmaxFused{
-
-    static constexpr bool RotateP = RotateP_;
-    using TensorT = decltype(make_fragment_like<float>(Shape<Int<Rows>>{}));
-    TensorT row_sum, row_max, scores_scale;
-    static constexpr float fp8_scalexfp4_scale = 1.f / (448 * 6);
-    static constexpr float fp8_scalexfp4_scale_log2 = -11.392317422778762f; //log2f(fp8_scalexfp4_scale)
-    static constexpr float fp8_scalexfp4_scale_log2_rot = fp8_scalexfp4_scale_log2 + 2.f; // 1/672: rotate-P scale encoding headroom
-    static constexpr float fp4_scale_log2 = -2.584962500721156f; // log2f(fp4_scale)
-    static constexpr int RowReductionThr = 4;
-
-    CUTLASS_DEVICE SoftmaxFused(){};
-
-    // In-place normalized Walsh-Hadamard H16 on 16 consecutive K positions.
-    //
-    // Due to the K-axis FP4 permutation (scaled_fp4_quant_permute), each
-    // thread in the quad holds 8 CONSECUTIVE K positions:
-    //   thread 0: K[0..7], thread 1: K[8..15],
-    //   thread 2: K[16..23], thread 3: K[24..31]   (within each ni tile).
-    // The 16-element rotation groups are therefore {threads 0+1} and
-    // {threads 2+3}, each covering 16 consecutive K positions.
-    //
-    // Butterfly stages (bit positions of the 16-element index):
-    //   bit 3 (d=8): shfl_xor(1)  — cross-thread (0↔1, 2↔3)
-    //   bit 2 (d=4): local v[i] ↔ v[i+4]
-    //   bit 1 (d=2): local v[i] ↔ v[i+2]
-    //   bit 0 (d=1): local v[i] ↔ v[i+1]
-    //   ×0.25 normalization  ((1/√2)^4)
-    CUTLASS_DEVICE static void hadamard16_kpos_(
-        float& v0, float& v1, float& v2, float& v3,
-        float& v4, float& v5, float& v6, float& v7,
-        int const t
-    ) {
-        // d = 8: shfl_xor(1) between thread pairs 0↔1 and 2↔3
-        float p0 = __shfl_xor_sync(int32_t(-1), v0, 1);
-        float p1 = __shfl_xor_sync(int32_t(-1), v1, 1);
-        float p2 = __shfl_xor_sync(int32_t(-1), v2, 1);
-        float p3 = __shfl_xor_sync(int32_t(-1), v3, 1);
-        float p4 = __shfl_xor_sync(int32_t(-1), v4, 1);
-        float p5 = __shfl_xor_sync(int32_t(-1), v5, 1);
-        float p6 = __shfl_xor_sync(int32_t(-1), v6, 1);
-        float p7 = __shfl_xor_sync(int32_t(-1), v7, 1);
-        if ((t & 1) == 0) {
-            v0 += p0; v1 += p1; v2 += p2; v3 += p3;
-            v4 += p4; v5 += p5; v6 += p6; v7 += p7;
-        } else {
-            v0 = p0 - v0; v1 = p1 - v1; v2 = p2 - v2; v3 = p3 - v3;
-            v4 = p4 - v4; v5 = p5 - v5; v6 = p6 - v6; v7 = p7 - v7;
-        }
-        // d = 4: local v[i] ↔ v[i+4]
-        float s0 = v0 + v4, d0 = v0 - v4;
-        float s1 = v1 + v5, d1 = v1 - v5;
-        float s2 = v2 + v6, d2 = v2 - v6;
-        float s3 = v3 + v7, d3 = v3 - v7;
-        v0 = s0; v1 = s1; v2 = s2; v3 = s3;
-        v4 = d0; v5 = d1; v6 = d2; v7 = d3;
-        // d = 2: local v[i] ↔ v[i+2]
-        s0 = v0 + v2; d0 = v0 - v2;
-        s1 = v1 + v3; d1 = v1 - v3;
-        float s4 = v4 + v6, d4 = v4 - v6;
-        float s5 = v5 + v7, d5 = v5 - v7;
-        v0 = s0; v1 = s1; v2 = d0; v3 = d1;
-        v4 = s4; v5 = s5; v6 = d4; v7 = d5;
-        // d = 1: local v[i] ↔ v[i+1]
-        s0 = v0 + v1; d0 = v0 - v1;
-        s1 = v2 + v3; d1 = v2 - v3;
-        s2 = v4 + v5; d2 = v4 - v5;
-        s3 = v6 + v7; d3 = v6 - v7;
-        // normalize: (1/sqrt(2))^4 = 1/4
-        v0 = 0.25f * s0; v1 = 0.25f * d0;
-        v2 = 0.25f * s1; v3 = 0.25f * d1;
-        v4 = 0.25f * s2; v5 = 0.25f * d2;
-        v6 = 0.25f * s3; v7 = 0.25f * d3;
-    }
-
-    // Rotate the whole P~ tile in K-position space and recompute AbsMaxP.
-    // Each ni tile's 8 j_idx registers per thread map to 8 consecutive K
-    // positions; threads 0+1 form one 16-K-position group and threads 2+3
-    // form the other.  The AbsMaxP SF-group partition (thread + shfl_xor(1)
-    // neighbour = 16 K positions) matches exactly.
-    template<typename TensorAcc, typename TensorMax>
-    CUTLASS_DEVICE void rotate_p_and_absmax_(
-        TensorAcc& acc_reduction_view, TensorMax& AbsMaxP
-    ) {
-        int const t = threadIdx.x & 3;
-        CUTLASS_PRAGMA_UNROLL
-        for (int mi = 0; mi < size<0>(acc_reduction_view); mi++) {
-            CUTLASS_PRAGMA_UNROLL
-            for (int ni = 0; ni < size<1, 1>(acc_reduction_view); ni++) {
-                float v0 = acc_reduction_view(mi, make_coord(0, ni));
-                float v1 = acc_reduction_view(mi, make_coord(1, ni));
-                float v2 = acc_reduction_view(mi, make_coord(2, ni));
-                float v3 = acc_reduction_view(mi, make_coord(3, ni));
-                float v4 = acc_reduction_view(mi, make_coord(4, ni));
-                float v5 = acc_reduction_view(mi, make_coord(5, ni));
-                float v6 = acc_reduction_view(mi, make_coord(6, ni));
-                float v7 = acc_reduction_view(mi, make_coord(7, ni));
-                hadamard16_kpos_(v0, v1, v2, v3, v4, v5, v6, v7, t);
-                acc_reduction_view(mi, make_coord(0, ni)) = v0;
-                acc_reduction_view(mi, make_coord(1, ni)) = v1;
-                acc_reduction_view(mi, make_coord(2, ni)) = v2;
-                acc_reduction_view(mi, make_coord(3, ni)) = v3;
-                acc_reduction_view(mi, make_coord(4, ni)) = v4;
-                acc_reduction_view(mi, make_coord(5, ni)) = v5;
-                acc_reduction_view(mi, make_coord(6, ni)) = v6;
-                acc_reduction_view(mi, make_coord(7, ni)) = v7;
-            }
-            CUTLASS_PRAGMA_UNROLL
-            for (int ni = 0; ni < size<1>(AbsMaxP); ni++) {
-                float am = 0.f;
-                CUTLASS_PRAGMA_UNROLL
-                for (int ei = 0; ei < size<1, 0>(acc_reduction_view); ei++) {
-                    am = fmaxf(am, fabsf(acc_reduction_view(mi, make_coord(ei, ni))));
-                }
-                am = fmaxf(am, fabsf(__shfl_xor_sync(int32_t(-1), am, 1)));
-                AbsMaxP(mi, ni) = am * (1.f / 6.f);
-            }
-        }
-    }
-
-    template<bool FirstTile, bool InfCheck = false, typename TensorAcc, typename TensorMax>
-    CUTLASS_DEVICE auto online_softmax_with_quant(
-        TensorAcc& acc,
-        TensorMax& AbsMaxP,
-        const float softmax_scale_log2
-    ) {
-        Tensor acc_reduction_view = make_tensor(acc.data(), flash::convert_to_reduction_layout(acc.layout()));
-        Tensor acc_conversion_view = make_tensor(acc.data(), flash::convert_to_conversion_layout(acc.layout()));
-        Tensor acc_conversion_flatten = group_modes<1, 5>(group_modes<0, 2>(flatten(acc_conversion_view)));
-        constexpr float scale_const = RotateP ? fp8_scalexfp4_scale_log2_rot : fp8_scalexfp4_scale_log2;
-
-        if constexpr (FirstTile) {
-            fill(row_max, -INFINITY);
-            clear(row_sum);
-            fill(scores_scale, 1.f);
-
-            CUTLASS_PRAGMA_UNROLL
-            for (int mi = 0; mi < size<0>(acc_reduction_view); mi++) {
-                CUTLASS_PRAGMA_UNROLL
-                for (int ni = 0; ni < size<1, 1>(acc_reduction_view); ni++) {
-                    CUTLASS_PRAGMA_UNROLL
-                    for (int ei = 0; ei < size<1, 0>(acc_reduction_view); ei++) {
-                        AbsMaxP(mi, ni) = fmaxf(AbsMaxP(mi, ni), acc_reduction_view(mi, make_coord(ei, ni)));
-                    }
-                    float max_recv = __shfl_xor_sync(int32_t(-1), AbsMaxP(mi, ni), 1); // exchange max with neighbour thread of 8 elements
-                    AbsMaxP(mi, ni) = fmaxf(AbsMaxP(mi, ni), max_recv);
-                    row_max(mi) = fmaxf(row_max(mi), AbsMaxP(mi, ni));
-                }
-
-                float max_recv = __shfl_xor_sync(int32_t(-1), row_max(mi), 2); // exchange max in a quad in a row
-                row_max(mi) = fmaxf(row_max(mi), max_recv);
-
-                const float max_scaled = InfCheck
-                                        ? (row_max(mi) == -INFINITY ? 0.f : (row_max(mi) * softmax_scale_log2 + scale_const))
-                                        : (row_max(mi) * softmax_scale_log2 + scale_const);
-                CUTLASS_PRAGMA_UNROLL
-                for (int ni = 0; ni < size<1>(acc_reduction_view); ni++) {
-                    acc_reduction_view(mi, ni) = flash::ptx_exp2(acc_reduction_view(mi, ni) * softmax_scale_log2 - max_scaled);
-                }
-                if constexpr (!RotateP) {
-                    CUTLASS_PRAGMA_UNROLL
-                    for (int sfi = 0; sfi < size<1>(AbsMaxP); sfi++) {
-                        AbsMaxP(mi, sfi) = flash::ptx_exp2(AbsMaxP(mi, sfi) * softmax_scale_log2 - max_scaled + fp4_scale_log2);
-                    }
-                }
-            }
-            CUTLASS_PRAGMA_UNROLL
-            for (int mi = 0; mi < size<0>(acc_reduction_view); mi++) {
-                CUTLASS_PRAGMA_UNROLL
-                for (int ni = 0; ni < size<1>(acc_reduction_view); ni++) {
-                    row_sum(mi) += acc_reduction_view(mi, ni);
-                }
-            }
-            if constexpr (RotateP) {
-                rotate_p_and_absmax_(acc_reduction_view, AbsMaxP);
-            }
-        }
-        else {
-            Tensor scores_max_prev = make_fragment_like(row_max);
-            cute::copy(row_max, scores_max_prev);
-            CUTLASS_PRAGMA_UNROLL
-            for (int mi = 0; mi < size<0>(acc_reduction_view); mi++) {
-                CUTLASS_PRAGMA_UNROLL
-                for (int ni = 0; ni < size<1, 1>(acc_reduction_view); ni++) {
-                    float local_max = -INFINITY;
-                    CUTLASS_PRAGMA_UNROLL
-                    for (int ei = 0; ei < size<1, 0>(acc_reduction_view); ei++) {
-                        local_max = fmaxf(local_max, acc_reduction_view(mi, make_coord(ei, ni)));
-                    }
-                    float max_recv = __shfl_xor_sync(int32_t(-1), local_max, 1); // exchange max with neighbour thread of 8 elements
-                    AbsMaxP(mi, ni) = fmaxf(local_max, max_recv);
-                    row_max(mi) = fmaxf(row_max(mi), AbsMaxP(mi, ni));
-                }
-
-                float max_recv = __shfl_xor_sync(int32_t(-1), row_max(mi), 2); // exchange max in a quad in a row
-                row_max(mi) = fmaxf(row_max(mi), max_recv);
-
-                float scores_max_cur = !InfCheck
-                                        ? row_max(mi)
-                                        : (row_max(mi) == -INFINITY ? 0.0f : row_max(mi));
-                scores_scale(mi) = flash::ptx_exp2((scores_max_prev(mi) - scores_max_cur) * softmax_scale_log2);
-
-                const float max_scaled = InfCheck
-                                        ? (row_max(mi) == -INFINITY ? 0.f : (row_max(mi) * softmax_scale_log2 + scale_const))
-                                        : (row_max(mi) * softmax_scale_log2 + scale_const);
-                row_sum(mi) = row_sum(mi) * scores_scale(mi);
-                CUTLASS_PRAGMA_UNROLL
-                for (int ni = 0; ni < size<1>(acc_reduction_view); ni++) {
-                    acc_reduction_view(mi, ni) = flash::ptx_exp2(acc_reduction_view(mi, ni) * softmax_scale_log2 - max_scaled);
-                    row_sum(mi) += acc_reduction_view(mi, ni);
-                }
-                if constexpr (!RotateP) {
-                    CUTLASS_PRAGMA_UNROLL
-                    for (int sfi = 0; sfi < size<1>(AbsMaxP); sfi++) {
-                        AbsMaxP(mi, sfi) = flash::ptx_exp2(AbsMaxP(mi, sfi) * softmax_scale_log2 - max_scaled + fp4_scale_log2);
-                    }
-                }
-                // scores_scale(mi) = max_scaled;
-            }
-            if constexpr (RotateP) {
-                rotate_p_and_absmax_(acc_reduction_view, AbsMaxP);
-            }
-        }
-        CUTLASS_PRAGMA_UNROLL
-        for (int i = 0; i < size(AbsMaxP); ++i) {
-            CUTLASS_PRAGMA_UNROLL
-            for (int j = 0; j < size<0>(acc_conversion_flatten); ++j)
-                acc_conversion_flatten(j, i) /= AbsMaxP(i);
-        }
-    }
-
-    template<typename TensorAcc>
-    CUTLASS_DEVICE void finalize(TensorAcc& o_store) {
-        Tensor o_store_reduction_view = make_tensor(o_store.data(), flash::convert_to_reduction_layout(o_store.layout()));
-        CUTLASS_PRAGMA_UNROLL
-        for (int mi = 0; mi < size(row_max); ++mi) {
-            CUTLASS_PRAGMA_UNROLL
-            for (int i = 1; i < RowReductionThr; i <<= 1) {
-                float sum_recv = __shfl_xor_sync(int32_t(-1), row_sum(mi), i);
-                row_sum(mi) += sum_recv;
-            }
-            float sum = row_sum(mi);
-            float inv_sum = (sum == 0.f || sum != sum) ? 0.f : 1 / sum;
-            CUTLASS_PRAGMA_UNROLL
-            for (int ni = 0; ni < size<1>(o_store_reduction_view); ++ni) {
-                o_store_reduction_view(mi, ni) *= inv_sum;
-             }
-        }
-    }
-
-    template<typename TensorAcc>
-    CUTLASS_DEVICE void rescale_o(TensorAcc& o_store, TensorAcc const& o_tmp) {
-        Tensor o_store_reduction_view = make_tensor(o_store.data(), flash::convert_to_reduction_layout(o_store.layout()));
-        Tensor o_tmp_reduction_view = make_tensor(o_tmp.data(), flash::convert_to_reduction_layout(o_tmp.layout()));
-        CUTLASS_PRAGMA_UNROLL
-        for (int mi = 0; mi < size(row_max); ++mi) {
-            CUTLASS_PRAGMA_UNROLL
-            for (int ni = 0; ni < size<1>(o_store_reduction_view); ++ni) {
-                o_store_reduction_view(mi, ni) = o_store_reduction_view(mi, ni) * scores_scale(mi) + o_tmp_reduction_view(mi, ni);
-             }
-        }
-
-    }
-
-    // Scale o_store in-place before the V TMA wait so the FMUL loop overlaps
-    // with memory latency and PV MMA can accumulate directly into o_store,
-    // eliminating the tOrO temp buffer and the post-MMA rescale_o FFMA chain.
-    template<typename TensorAcc>
-    CUTLASS_DEVICE void pre_scale_o(TensorAcc& o_store) {
-        Tensor o_store_reduction_view = make_tensor(o_store.data(), flash::convert_to_reduction_layout(o_store.layout()));
-        CUTLASS_PRAGMA_UNROLL
-        for (int mi = 0; mi < size(row_max); ++mi) {
-            CUTLASS_PRAGMA_UNROLL
-            for (int ni = 0; ni < size<1>(o_store_reduction_view); ++ni) {
-                o_store_reduction_view(mi, ni) *= scores_scale(mi);
-            }
-        }
-    }
-
-};
-} // namespace flash
