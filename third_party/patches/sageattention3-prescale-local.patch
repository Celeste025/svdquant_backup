-                                make_tile(make_layout(size<1>(thr_layout_vmnk)),
-                                          make_layout(size<3>(thr_layout_vmnk))));
-      auto thr_tensor = zipped_divide(tv_tensor, thr_tile);            // ((ThrV,(ThrM,ThrK)),(FrgV,(RestM,RestK)))
-  
-      return thr_tensor;
-    }
