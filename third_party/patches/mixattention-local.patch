 def round_rne_e2m1(x: torch.Tensor) -> torch.Tensor:
     """RNE rounding to the e2m1 grid {0, .5, 1, 1.5, 2, 3, 4, 6}.
 
-    Compare chain instead of searchsorted (same results incl. the exact tie
-    rule — ties at a grid midpoint pick the side given by the original
-    searchsorted implementation's `idx % 2 == 1`; everything >= 5 maps to 6,
-    so no clamp is needed). ~3x fewer memory passes: this runs once per
-    P tile per head at generation time (8e10 elements per attention call).
+    Exact midpoints go to the E2M1 code with an even low bit, matching
+    ``cvt.rn.satfinite.e2m1x2.f32``. The comparisons below follow the same
+    rule as the searchsorted reference. Everything above 5 maps to 6.
     """
     ax = x.abs()
     r = torch.zeros_like(ax)
-    r = torch.where(ax >= 0.25, 0.5, r)
-    r = torch.where(ax > 0.75, 1.0, r)
-    r = torch.where(ax >= 1.25, 1.5, r)
-    r = torch.where(ax > 1.75, 2.0, r)
-    r = torch.where(ax >= 2.5, 3.0, r)
-    r = torch.where(ax > 3.5, 4.0, r)
-    r = torch.where(ax >= 5.0, 6.0, r)
+    r = torch.where(ax > 0.25, 0.5, r)
+    r = torch.where(ax >= 0.75, 1.0, r)
+    r = torch.where(ax > 1.25, 1.5, r)
+    r = torch.where(ax >= 1.75, 2.0, r)
+    r = torch.where(ax > 2.5, 3.0, r)
+    r = torch.where(ax >= 3.5, 4.0, r)
+    r = torch.where(ax > 5.0, 6.0, r)
     return torch.sign(x) * r
 
 
