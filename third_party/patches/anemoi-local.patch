+      at::cuda::getCurrentCUDAStream(logical_ids.get_device());
+  if (use_short) {
+    pack_route_ids_kernel<<<
+        static_cast<unsigned int>(row_count), kThreads, 0, stream>>>(
+        logical_ids.data_ptr<int>(), offsets.data_ptr<int>(),
+        low_counts.data_ptr<int>(), middle_counts.data_ptr<int>(),
+        high_counts.data_ptr<int>(), packed.data_ptr<int16_t>(),
+        static_cast<int>(row_count), static_cast<int>(logical_columns));
+  } else {
+    pack_route_ids_kernel<<<
+        static_cast<unsigned int>(row_count), kThreads, 0, stream>>>(
+        logical_ids.data_ptr<int>(), offsets.data_ptr<int>(),
+        low_counts.data_ptr<int>(), middle_counts.data_ptr<int>(),
+        high_counts.data_ptr<int>(), packed.data_ptr<int>(),
+        static_cast<int>(row_count), static_cast<int>(logical_columns));
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return {packed, offsets};
+}
+
+std::tuple<torch::Tensor, torch::Tensor, torch::Tensor, torch::Tensor>
+sm120_h3_materialize_packed_route(
+    torch::Tensor packed_ids,
+    torch::Tensor row_offsets,
+    torch::Tensor low_counts,
+    torch::Tensor middle_counts,
+    torch::Tensor high_counts,
+    int64_t logical_columns_value,
+    int64_t query_block_size_value,
+    int64_t prefix_blocks_value,
+    int64_t prefix_phase_value,
+    bool prefix_first,
+    bool has_high) {
+  TORCH_CHECK(
+      packed_ids.defined() && packed_ids.is_cuda() &&
+          packed_ids.is_contiguous() && packed_ids.dim() == 1 &&
+          (packed_ids.scalar_type() == at::ScalarType::Short ||
+           packed_ids.scalar_type() == at::ScalarType::Int),
+      "packed_ids must be contiguous CUDA int16/int32 [N]");
+  const auto check_counts = [&](const torch::Tensor& counts, const char* name) {
+    TORCH_CHECK(
+        counts.defined() && counts.is_cuda() && counts.is_contiguous() &&
+            counts.scalar_type() == at::ScalarType::Int &&
+            counts.device() == packed_ids.device() && counts.dim() == 3,
+        name, " must be contiguous CUDA int32 [B,H,R]");
+  };
+  check_counts(low_counts, "low_counts");
+  check_counts(middle_counts, "middle_counts");
+  check_counts(high_counts, "high_counts");
+  TORCH_CHECK(
+      middle_counts.sizes() == low_counts.sizes() &&
+          high_counts.sizes() == low_counts.sizes(),
+      "all packed route count tensors must have matching shapes");
+  const int64_t row_count = low_counts.numel();
+  TORCH_CHECK(
+      row_offsets.defined() && row_offsets.is_cuda() &&
+          row_offsets.is_contiguous() &&
+          row_offsets.scalar_type() == at::ScalarType::Int &&
+          row_offsets.device() == packed_ids.device() &&
+          row_offsets.dim() == 1 && row_offsets.numel() == row_count + 1,
+      "row_offsets must be contiguous CUDA int32 [rows+1]");
+  const int logical_columns =
+      require_nonnegative_int32(logical_columns_value, "logical_columns");
+  TORCH_CHECK(logical_columns > 0, "logical_columns must be positive");
+  TORCH_CHECK(
+      query_block_size_value == 64 || query_block_size_value == 128,
+      "query_block_size must be 64 or 128");
+  const int prefix_blocks =
+      require_nonnegative_int32(prefix_blocks_value, "prefix_blocks");
+  const int prefix_phase =
+      require_nonnegative_int32(prefix_phase_value, "prefix_phase");
+  TORCH_CHECK(prefix_phase < 3, "prefix_phase must be 0, 1, or 2");
+  TORCH_CHECK(
+      has_high || prefix_phase != 2,
+      "FP16 prefix requires active high counts");
+
+  const int factor = static_cast<int>(query_block_size_value / 64);
+  const int64_t physical_columns_value =
+      checked_positive_product(logical_columns, factor, "physical route columns") +
+      prefix_blocks;
+  TORCH_CHECK(
+      physical_columns_value <= std::numeric_limits<int>::max() &&
+          row_count > 0 && row_count <= kMaxGridX,
+      "packed physical route geometry exceeds CUDA range");
+
+  c10::cuda::CUDAGuard device_guard(packed_ids.device());
+  auto physical_sizes = low_counts.sizes().vec();
+  physical_sizes.push_back(physical_columns_value);
+  auto physical_ids = torch::empty(
+      physical_sizes, packed_ids.options().dtype(at::ScalarType::Int));
+  auto physical_low_counts = torch::empty_like(low_counts);
+  auto physical_middle_counts = torch::empty_like(middle_counts);
+  auto physical_high_counts = has_high
+      ? torch::empty_like(high_counts)
+      : torch::empty({0}, high_counts.options());
+  const cudaStream_t stream =
+      at::cuda::getCurrentCUDAStream(packed_ids.get_device());
+#define MPA_LAUNCH_PACKED_MATERIALIZE(id_type) \
+  materialize_packed_route_kernel<<< \
+      static_cast<unsigned int>(row_count), kThreads, 0, stream>>>( \
+      packed_ids.data_ptr<id_type>(), row_offsets.data_ptr<int>(), \
+      low_counts.data_ptr<int>(), middle_counts.data_ptr<int>(), \
+      high_counts.data_ptr<int>(), physical_ids.data_ptr<int>(), \
+      physical_low_counts.data_ptr<int>(), \
+      physical_middle_counts.data_ptr<int>(), \
+      has_high ? physical_high_counts.data_ptr<int>() : nullptr, \
+      static_cast<int>(row_count), static_cast<int>(physical_columns_value), \
+      factor, prefix_blocks, prefix_phase, prefix_first, has_high)
+  if (packed_ids.scalar_type() == at::ScalarType::Short) {
+    MPA_LAUNCH_PACKED_MATERIALIZE(int16_t);
+  } else {
+    MPA_LAUNCH_PACKED_MATERIALIZE(int);
+  }
+#undef MPA_LAUNCH_PACKED_MATERIALIZE
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return {
+      physical_ids,
+      physical_low_counts,
+      physical_middle_counts,
+      physical_high_counts};
+}
+#endif
+
 #undef MPA_ROUTE_PRECISION_FUNCTION
 #undef MPA_MATERIALIZE_ROUTE_FUNCTION
 #undef MPA_ROUTE_DEVICE_OK
